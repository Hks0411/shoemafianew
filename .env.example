# Cloud MySQL (Aiven). ssl-mode=REQUIRED; app maps SSL for Prisma on Vercel automatically.
# DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-xxxx.l.aivencloud.com:15203/defaultdb?ssl-mode=REQUIRED"
# Local-only MySQL example:
# DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/shoe_mafia"
DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-xxxx.l.aivencloud.com:15203/defaultdb?ssl-mode=REQUIRED"

# App
APP_URL="http://localhost:3000"
# Local dev only. On Render/hosting use production (see render.yaml).
NODE_ENV="development"

# Admin session signing secret (long random string)
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Admin portal login. The first start creates this account if the database is empty.
ADMIN_USERNAME="sHoeMafia"
ADMIN_PASSWORD="change-me-before-production"
ADMIN_EMAIL="admin@shoemaafia.local"

# Razorpay (leave blank until keys are provided)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Product and banner images are stored in MySQL (StoredImage table). No external image host required.

# Set to 0 on Vercel (serverless). On Render/VPS leave 1 or run `npm run worker` separately.
IMPORT_WORKER="1"

# --- Vercel (Settings → Environment Variables → Production) ---
# DATABASE_URL must be REAL cloud MySQL host — never copy "YOUR-MYSQL-HOST" literally.
# Aiven example (SSL required — app maps ssl-mode to sslaccept on Vercel):
# mysql://avnadmin:PASSWORD@mysql-xxxx.l.aivencloud.com:15203/defaultdb?ssl-mode=REQUIRED
# Vercel also set: APP_URL, ADMIN_SESSION_SECRET, IMPORT_WORKER=0
# After creating the DB, run migrations once from your PC:
#   node scripts/migrate-production.mjs   (with DATABASE_URL set to the same URL)
# Also set: ADMIN_SESSION_SECRET, APP_URL, ADMIN_USERNAME, ADMIN_PASSWORD, IMPORT_WORKER=0
